generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Oficiais {
  id           Int      @id @default(autoincrement())
  name         String
  gameId       Int
  unidade      String
  cargoUnidade String
  numero       String
  image        String
  createdAt    DateTime @default(now())
  cargoSpeed   String?
  codenome     String?
}
